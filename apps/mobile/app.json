{
  "expo": {
    "name": "Safe Track Centrum",
    "slug": "safe-track-centrum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.centrumconcierge.safetrack",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.centrumconcierge.safetrack",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Safe Track Centrum needs camera access to scan checkpoint QR codes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Safe Track Centrum needs photo library access to attach photos to an incident report.",
          "cameraPermission": "Safe Track Centrum needs camera access to take a photo for an incident report.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0ddb0771-b6fe-4100-ac1a-b1a89e4dba34"
      }
    },
    "owner": "centrum-it"
  }
}
